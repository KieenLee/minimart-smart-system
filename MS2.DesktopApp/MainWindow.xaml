<Window x:Class="MS2.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMart Smart System"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#1A2340">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Border Grid.Row="0" Padding="20,24,20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#F59E0B" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="MiniMart" FontSize="18" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Smart System" FontSize="11" Foreground="#64748B" Margin="42,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- USER INFO -->
                <Border Grid.Row="1" Margin="12,0,12,12" Background="#243060" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.FullName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentUser.Role}"
                                   FontSize="11" Foreground="#F59E0B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- NAV MENU -->
                <StackPanel Grid.Row="2">
                    <!-- Section: General -->
                    <TextBlock Text="CHỨC NĂNG" FontSize="10" FontWeight="Bold"
                               Foreground="#475569" Margin="20,8,0,4"/>

                    <Button Content="🛍  BÁN HÀNG (POS)"
                            Command="{Binding NavigateToPosCommand}"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="📦  ĐƠN HÀNG ONLINE"
                            Command="{Binding NavigateToOrdersCommand}"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="👤  HỒ SƠ CÁ NHÂN"
                            Command="{Binding NavigateToProfileCommand}"
                            Style="{StaticResource NavButton}"/>

                    <!-- Section: Admin only -->
                    <TextBlock Text="QUẢN TRỊ" FontSize="10" FontWeight="Bold"
                               Foreground="#475569" Margin="20,16,0,4"
                               Visibility="{Binding IsAdmin}"/>

                    <Button Content="📋  QUẢN LÝ ĐƠN ONLINE"
                            Command="{Binding NavigateToAdminOrdersCommand}"
                            Style="{StaticResource NavAdminButton}"
                            Visibility="{Binding IsAdmin}"/>

                    <Button Content="📊  KHO HÀNG"
                            Command="{Binding NavigateToInventoryCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding IsAdmin}"/>

                    <Button Content="📈  BÁO CÁO"
                            Command="{Binding NavigateToReportsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding IsAdmin}"/>

                    <Button Content="👥  NHÂN VIÊN"
                            Command="{Binding NavigateToEmployeesCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding IsAdmin}"/>
                </StackPanel>

                <!-- LOGOUT -->
                <Border Grid.Row="3" BorderBrush="#243060" BorderThickness="0,1,0,0" Margin="0,0,0,8">
                    <Button Content="🚪  ĐĂNG XUẤT"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource LogoutButton}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Border Grid.Column="1" Background="#F1F5F9" Padding="0">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>
