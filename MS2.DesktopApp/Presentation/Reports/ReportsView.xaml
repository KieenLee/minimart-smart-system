<UserControl x:Class="MS2.DesktopApp.Presentation.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0" Background="White" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📈  BÁO CÁO DOANH THU" FontSize="20" FontWeight="Bold" Foreground="#1A2340"/>
                    <TextBlock Text="{Binding LastUpdated}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,12,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Content="🔄 Làm mới" Style="{StaticResource PrimaryButton}"
                            Height="36" Command="{Binding LoadReportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATE FILTER -->
        <Border Grid.Row="1" Background="White" Padding="20,12"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày:" FontSize="13" FontWeight="SemiBold"
                           Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" FontSize="13" Width="140" Margin="0,0,20,0"/>
                <TextBlock Text="Đến ngày:" FontSize="13" FontWeight="SemiBold"
                           Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" FontSize="13" Width="140"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KPI CARDS -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng doanh thu -->
                <Border Grid.Column="0" Background="White" CornerRadius="12"
                        Margin="0,0,8,0" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="8" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#DBEAFE" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DOANH THU" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1A2340">
                            <Run Text="{Binding TotalRevenue, StringFormat='{}{0:N0}'}"/>
                            <Run Text="đ" Foreground="#94A3B8" FontSize="16"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tổng đơn -->
                <Border Grid.Column="1" Background="White" CornerRadius="12"
                        Margin="4,0,4,0" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="8" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#DCFCE7" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TỔNG ĐƠN" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#16A34A">
                            <Run Text="{Binding TotalOrders}"/>
                            <Run Text=" đơn" Foreground="#94A3B8" FontSize="16"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Trung bình -->
                <Border Grid.Column="2" Background="White" CornerRadius="12"
                        Margin="8,0,0,0" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="8" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEF3C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TRUNG BÌNH / ĐƠN" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#D97706">
                            <Run Text="{Binding AverageOrderValue, StringFormat='{}{0:N0}'}"/>
                            <Run Text="đ" Foreground="#94A3B8" FontSize="16"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ORDERS TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="12"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Orders}" BorderThickness="0" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                        <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeName}" Width="150"/>
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}đ'}" Width="130"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>
