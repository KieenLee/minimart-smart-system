<Window x:Class="MS2.DesktopApp.Presentation.Inventory.CreateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Sản Phẩm Mới"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <Border Background="#1A2340" CornerRadius="10" Padding="20,14" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#F59E0B" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tạo Sản Phẩm Mới" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Điền đầy đủ thông tin bên dưới" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form Card -->
            <Border Background="White" CornerRadius="10" Padding="24"
                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Tên sản phẩm -->
                    <TextBlock Text="Tên sản phẩm *" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtName" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Danh mục -->
                    <TextBlock Text="Danh mục *" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboCategory" Height="38" Margin="0,0,0,14"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCategoryId}"/>

                    <!-- Giá bán -->
                    <TextBlock Text="Giá bán (đ) *" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtPrice" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,14"
                             Text="0"/>

                    <!-- Tồn kho ban đầu -->
                    <TextBlock Text="Tồn kho ban đầu" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtStock" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,14"
                             Text="0"/>

                    <!-- Barcode -->
                    <TextBlock Text="Barcode (tùy chọn)" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtBarcode" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                </StackPanel>
            </Border>

            <!-- Error message -->
            <Border x:Name="ErrorBorder" Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                    Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Style="{StaticResource SecondaryButton}"
                        Height="42" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Grid.Column="1" Content="✅ Tạo Sản Phẩm" Style="{StaticResource SuccessButton}"
                        Height="42" Margin="8,0,0,0" Click="CreateButton_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
