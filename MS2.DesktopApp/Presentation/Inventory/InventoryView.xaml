<UserControl x:Class="MS2.DesktopApp.Presentation.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0" Background="White" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📦  QUẢN LÝ KHO HÀNG"
                           FontSize="20" FontWeight="Bold" Foreground="#1A2340"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="260" Height="38" VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🔍 Tìm" Style="{StaticResource PrimaryButton}"
                            Height="38" Margin="0,0,8,0"
                            Command="{Binding SearchProductsCommand}"/>
                    <Button Content="↻ Tải lại" Style="{StaticResource SecondaryButton}"
                            Height="38" Command="{Binding LoadProductsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- PRODUCT TABLE -->
            <Border Grid.Column="0" Background="White" Margin="16,16,8,16"
                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          SelectionMode="Single"
                          BorderThickness="0"
                          RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="130"/>
                        <DataGridTextColumn Header="Giá bán" Binding="{Binding Price, StringFormat='{}{0:N0}đ'}" Width="110"/>
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding Stock}" Width="80"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- EDIT PANEL -->
            <Border Grid.Column="1" Background="White" Margin="8,16,16,16"
                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CHỈNH SỬA" FontSize="12" FontWeight="Bold"
                               Foreground="#64748B" Margin="0,0,0,16"/>

                    <TextBlock Text="Sản phẩm đang chọn" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#F0F9FF" CornerRadius="8" Padding="10,8" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SelectedProduct.Name}"
                                   FontSize="14" FontWeight="Bold" Foreground="#1E293B"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Giá mới (đ)" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewPrice}" Height="38"
                             VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="💾 Cập nhật Giá"
                            Style="{StaticResource PrimaryButton}"
                            Height="38" Margin="0,0,0,24"
                            Command="{Binding UpdatePriceCommand}"/>

                    <Separator Background="#E2E8F0" Margin="0,0,0,20"/>

                    <TextBlock Text="Tồn kho mới" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewStock}" Height="38"
                             VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="📦 Cập nhật Tồn kho"
                            Style="{StaticResource SuccessButton}"
                            Height="38"
                            Command="{Binding UpdateStockCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>
