<UserControl x:Class="MS2.DesktopApp.Presentation.POS.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1200"
             Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0" Background="White" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🛍  BÁN HÀNG (POS)" FontSize="20" FontWeight="Bold"
                               Foreground="#1A2340"/>
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="300" Height="38"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0" Padding="12,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🔍 Tìm kiếm" Style="{StaticResource PrimaryButton}"
                            Height="38" Margin="0,0,10,0" Padding="16,0"
                            Command="{Binding SearchProductsCommand}"/>
                    <Button Content="↻ Tải lại" Style="{StaticResource SecondaryButton}"
                            Height="38" Padding="16,0"
                            Command="{Binding LoadProductsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- PRODUCT LIST (GRID/WRAP PANEL) -->
            <Border Grid.Column="0" Background="White" Margin="16,16,8,16"
                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC" CornerRadius="12,12,0,0">
                        <TextBlock Text="📌 TOÀN BỘ HÀNG HÓA" FontSize="13" FontWeight="Bold"
                                   Foreground="#64748B"/>
                    </Border>

                    <!-- Lưới sản phẩm dùng WrapPanel -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Products}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="White" Margin="8,8,0,8">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" VerticalAlignment="Top" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Product Card -->
                                <Border Height="190" Background="White"
                                        CornerRadius="12" Margin="6" Padding="12"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand">
                                    <!-- Hiệu ứng hover cho thẻ -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="64"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Placeholder Image (Giả lập ảnh SP) -->
                                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" Margin="0,0,0,8">
                                            <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Tên Sản Phẩm -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                   Foreground="#1E293B" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- Tồn kho & Giá -->
                                        <Grid Grid.Row="2" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center">
                                                <Run Text="Tồn: "/>
                                                <Run Text="{Binding Stock}" FontWeight="Bold" Foreground="#10B981"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center">
                                                <Run Text="{Binding Price, StringFormat='{}{0:N0}'}"/>
                                                <Run Text="đ" FontSize="11" Foreground="#94A3B8"/>
                                            </TextBlock>
                                        </Grid>
                                        
                                        <!-- Nút Thêm Vào Giỏ Nhanh -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="+1" Tag="1" Height="28" Margin="0,0,2,0" Style="{StaticResource SuccessButton}" FontSize="11" Padding="0" Click="AddToCartButton_Click"/>
                                            <Button Grid.Column="1" Content="+6" Tag="6" Height="28" Margin="2,0,2,0" Style="{StaticResource SuccessButton}" FontSize="11" Padding="0" ToolTip="Lốc (6)" Click="AddToCartButton_Click"/>
                                            <Button Grid.Column="2" Content="+10" Tag="10" Height="28" Margin="2,0,2,0" Style="{StaticResource SuccessButton}" FontSize="11" Padding="0" ToolTip="Chục (10)" Click="AddToCartButton_Click"/>
                                            <Button Grid.Column="3" Content="+12" Tag="12" Height="28" Margin="2,0,0,0" Style="{StaticResource SuccessButton}" FontSize="11" Padding="0" ToolTip="Tá (12)" Click="AddToCartButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CART PANEL (BÊN PHẢI) -->
            <Border Grid.Column="1" Background="White" Margin="8,16,16,16"
                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header (Tiêu đề hóa đơn) -->
                    <Border Grid.Row="0" Background="#1A2340" CornerRadius="12,12,0,0" Padding="16,14">
                        <Grid>
                            <TextBlock Text="🧾  HÓA ĐƠN: KHÁCH LẺ" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tiêu đề cột Giỏ hàng -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/> <!-- Delete btn area -->
                                <ColumnDefinition Width="*"/>  <!-- Name -->
                                <ColumnDefinition Width="50"/> <!-- Quantity -->
                                <ColumnDefinition Width="80"/> <!-- Total Price -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="TÊN MẶT HÀNG" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="SL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="THÀNH TIỀN" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Cart Items Danh sách  -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding CartItems}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Margin="0,4,0,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Xóa -->
                                        <Button Grid.Column="0" Content="✕" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                                Background="#FEF2F2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" Padding="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                                
                                        <!-- Tên & Đơn Giá -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProductName}" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                <Run Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}"/>
                                                <Run Text="đ"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Số lượng -->
                                        <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="46" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" 
                                                 FontSize="13" FontWeight="Bold" Foreground="#334155" 
                                                 Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" 
                                                 Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Thành tiền -->
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#2563EB" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tổng Cộng -->
                    <Border Grid.Row="3" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Padding="20,16">
                        <Grid>
                            <TextBlock Text="TỔNG SỐ TIỀN" FontSize="14" FontWeight="Bold"
                                       Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="24" FontWeight="Bold" Foreground="#DC2626">
                                <Run Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"/>
                                <Run Text="đ" Foreground="#94A3B8" FontSize="16"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Nút Thanh Toán -->
                    <Grid Grid.Row="4" Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🗑 Hủy (F4)"
                                Style="{StaticResource DangerButton}"
                                Height="50" Margin="0,0,10,0" FontSize="14" FontWeight="Bold"
                                Command="{Binding ClearCartCommand}"/>
                        <Button Grid.Column="1" Content="💳 THANH TOÁN (F9)"
                                Style="{StaticResource SuccessButton}"
                                Background="#10B981"
                                Height="50" FontSize="16" FontWeight="Bold"
                                Command="{Binding CheckoutCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
