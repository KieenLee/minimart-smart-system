<Window x:Class="MS2.DesktopApp.Presentation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMart Smart System"
        MinHeight="560" MinWidth="420"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1A2340">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LOGO HEADER -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="32,36,32,28">
                <Border Background="#F59E0B" CornerRadius="16" Width="64" Height="64"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="🛒" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="MiniMart Smart System"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Hệ thống quản lý siêu thị mini"
                           FontSize="12" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- FORM CARD -->
            <Border Grid.Row="1" Background="White" CornerRadius="16"
                    Margin="28,0,28,28" Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="28" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Đăng nhập"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1A2340" Margin="0,0,0,24"/>

                    <!-- Username -->
                    <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtUsername"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Margin="0,0,0,16"
                             VerticalContentAlignment="Center"/>

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtPassword"
                                 Height="40" Margin="0,0,0,8"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="TxtPassword_OnPasswordChanged"/>

                    <!-- Error -->
                    <Border Background="#FEF2F2" CornerRadius="6" Padding="10,8"
                            Margin="0,4,0,12"
                            Visibility="{Binding ErrorVisibility}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12" Foreground="#DC2626"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Login Button -->
                    <Button Content="ĐĂNG NHẬP"
                            Command="{Binding LoginCommand}"
                            Height="44" FontSize="14" FontWeight="Bold"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,4,0,0"/>

                    <!-- Footer -->
                    <TextBlock Text="© 2025 MiniMart System"
                               HorizontalAlignment="Center"
                               Foreground="#94A3B8" FontSize="11" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
