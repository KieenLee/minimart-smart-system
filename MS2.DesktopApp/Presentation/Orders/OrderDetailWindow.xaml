<Window x:Class="MS2.DesktopApp.Presentation.Orders.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Đơn Hàng"
        Width="500" SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <Border Background="#1A2340" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="#94A3B8" Text="MÃ ĐƠN HÀNG"/>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White">
                            <Run Text="#"/><Run Text="{Binding Id}"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- Status Badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            CornerRadius="12" Padding="12,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter Property="Background" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Shipping">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" Foreground="White"
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Info Card -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Khách hàng -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                        <TextBlock Text="KHÁCH HÀNG" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding CustomerName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#1E293B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Ngày đặt -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="NGÀY ĐẶT" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}"
                                   FontSize="14" Foreground="#1E293B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Tổng tiền -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                        <TextBlock Text="TỔNG TIỀN" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0">
                            <Run Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}"/>
                            <Run Text="đ" Foreground="#94A3B8" FontSize="14"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Người duyệt -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="NGƯỜI DUYỆT" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock FontSize="14" Foreground="#1E293B" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ApproverName}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApproverName}" Value="">
                                            <Setter Property="Text" Value="Chưa duyệt"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Thời gian duyệt -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="THỜI GIAN DUYỆT" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock FontSize="14" Foreground="#1E293B" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ApprovedAt, StringFormat=dd/MM/yyyy HH:mm}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApprovedAt}" Value="{x:Null}">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ghi Chú -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GHI CHÚ / ĐỊA CHỈ GIAO HÀNG" FontSize="10" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Notes}" FontSize="14" Foreground="#374151"
                               TextWrapping="Wrap" LineHeight="22">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                        <Setter Property="Text" Value="(Không có ghi chú)"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <Button Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Height="40" Click="CloseButton_Click"
                    HorizontalAlignment="Right" Width="120"/>
        </StackPanel>
    </ScrollViewer>
</Window>
