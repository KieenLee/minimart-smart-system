<UserControl x:Class="MS2.DesktopApp.Presentation.Orders.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="#DBEAFE" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                <TextBlock Text="📋" FontSize="20" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ ĐƠN HÀNG ONLINE" FontSize="20" FontWeight="Bold" Foreground="#1A2340"/>
                <TextBlock Text="Theo dõi và quản lý tất cả đơn hàng online" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </StackPanel>

        <!-- FILTER + REFRESH BAR -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12"
                Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lọc trạng thái:" FontSize="13" FontWeight="SemiBold"
                           Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"
                          Height="34" FontSize="13"/>
                <Button Grid.Column="3" Content="🔄  Làm Mới"
                        Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Command="{Binding RefreshOrdersAsyncCommand}"/>
            </Grid>
        </Border>

        <!-- TABLE CARD -->
        <Border Grid.Row="2" Background="White" CornerRadius="12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Orders}"
                      BorderThickness="0" RowHeight="48">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding Id}" Width="75"/>
                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="150"/>
                    <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding OrderDate, StringFormat=dd/MM/yy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}đ'}" Width="110"/>

                    <!-- STATUS BADGE -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,4" HorizontalAlignment="Center" Margin="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#9E9E9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Shipping">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="#16A34A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Người Duyệt" Binding="{Binding ApproverName}" Width="130"/>
                    <DataGridTextColumn Header="Thời Gian Duyệt" Binding="{Binding ApprovedAt, StringFormat=dd/MM/yy HH:mm}" Width="130"/>

                    <!-- Nút Chi tiết -->
                    <DataGridTemplateColumn Header="Chi Tiết" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Xem"
                                        Command="{Binding DataContext.ShowOrderDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#EFF6FF" Foreground="#2563EB"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderBrush="#BFDBFE" BorderThickness="1"
                                        Padding="8,4" Cursor="Hand"
                                        Height="30" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Padding="4,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>
