@{
    ViewData["Title"] = "Trang chủ";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center">
                <h1 class="display-4 text-primary mb-3">Chào mừng đến với MiniMart</h1>
                <p class="lead mb-4">Hệ thống quản lý siêu thị thông minh</p>
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">
                        Xem sản phẩm
                    </a>
                    @if (Context.Session.GetString("Username") == null)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                            Đăng ký ngay
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-4 text-center mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <svg class="cart text-primary mb-3" width="48" height="48">
                            <use xlink:href="#cart"></use>
                        </svg>
                        <h5 class="card-title">Mua sắm dễ dàng</h5>
                        <p class="card-text">Đặt hàng online nhanh chóng, tiện lợi</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <svg class="heart text-primary mb-3" width="48" height="48">
                            <use xlink:href="#heart"></use>
                        </svg>
                        <h5 class="card-title">Sản phẩm chất lượng</h5>
                        <p class="card-text">Cam kết chất lượng, giá cả hợp lý</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <svg class="user text-primary mb-3" width="48" height="48">
                            <use xlink:href="#user"></use>
                        </svg>
                        <h5 class="card-title">Hỗ trợ 24/7</h5>
                        <p class="card-text">Đội ngũ hỗ trợ luôn sẵn sàng phục vụ</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
