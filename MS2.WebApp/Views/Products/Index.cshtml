@model MS2.WebApp.Models.ProductListViewModel
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<section class="py-5">
    <div class="container">
        
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-md-12">
                <h2 class="text-primary">Danh sách sản phẩm</h2>
                <p class="text-muted">Chọn sản phẩm yêu thích của bạn</p>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="row mb-4">
            <div class="col-md-8">
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="search" value="@Model.SearchKeyword" 
                           class="form-control" placeholder="Tìm kiếm sản phẩm..." />
                    <button type="submit" class="btn btn-primary">
                        <svg width="20" height="20">
                            <use xlink:href="#search"></use>
                        </svg>
                        Tìm
                    </button>
                </form>
            </div>
            <div class="col-md-4">
                <form asp-action="Index" method="get">
                    <input type="hidden" name="search" value="@Model.SearchKeyword" />
                    <select name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@(Model.SelectedCategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="row">
            @if (Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    <svg class="text-primary" width="80" height="80">
                                        <use xlink:href="#cart"></use>
                                    </svg>
                                </div>
                                <h5 class="card-title">@product.Name</h5>
                                <p class="text-primary fw-bold fs-5">@product.Price.ToString("N0") đ</p>
                                <p class="text-muted small">Còn: @product.Stock</p>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">Số lượng</span>
                                        <input type="number" name="quantity" value="1" min="1" max="@product.Stock" 
                                               class="form-control" style="max-width: 80px;" />
                                    </div>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <svg width="16" height="16" class="me-1">
                                                <use xlink:href="#cart"></use>
                                            </svg>
                                            Thêm vào giỏ
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12">
                    <div class="alert alert-info text-center">
                        <p class="mb-0">Không tìm thấy sản phẩm nào.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="row mt-4">
                <div class="col-md-12">
                    <nav>
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       asp-action="Index" 
                                       asp-route-search="@Model.SearchKeyword"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-page="@(Model.CurrentPage - 1)">
                                        Trước
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" 
                                       asp-action="Index"
                                       asp-route-search="@Model.SearchKeyword"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       asp-action="Index"
                                       asp-route-search="@Model.SearchKeyword"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-page="@(Model.CurrentPage + 1)">
                                        Sau
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        }

    </div>
</section>
