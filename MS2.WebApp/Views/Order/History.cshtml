@model MS2.WebApp.Models.OrderHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<section class="py-5">
    <div class="container">
        
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-md-12">
                <h2 class="text-primary">Lịch sử đơn hàng</h2>
                <p class="text-muted">Quản lý và theo dõi đơn hàng của bạn</p>
            </div>
        </div>

        @if (!Model.Orders.Any())
        {
            <!-- Empty State -->
            <div class="row">
                <div class="col-md-12">
                    <div class="card border-0 shadow-sm text-center p-5">
                        <div class="card-body">
                            <svg class="text-muted mb-3" width="80" height="80" viewBox="0 0 24 24">
                                <use xlink:href="#cart"></use>
                            </svg>
                            <h4 class="text-muted mb-3">Chưa có đơn hàng nào</h4>
                            <p class="text-muted mb-4">Bạn chưa đặt hàng. Hãy khám phá các sản phẩm của chúng tôi!</p>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                                Xem sản phẩm
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Orders Table -->
            <div class="row">
                <div class="col-md-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mã đơn hàng</th>
                                            <th>Ngày đặt</th>
                                            <th>Tổng tiền</th>
                                            <th>Trạng thái</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.Orders)
                                        {
                                            <tr>
                                                <td>
                                                    <strong class="text-primary">#@order.Id</strong>
                                                </td>
                                                <td>
                                                    @order.OrderDate.ToString("dd/MM/yyyy")<br />
                                                    <small class="text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                                </td>
                                                <td>
                                                    <strong>@order.TotalAmount.ToString("N0") đ</strong>
                                                </td>
                                                <td>
                                                    @switch (order.Status)
                                                    {
                                                        case "Pending":
                                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                            break;
                                                        case "Processing":
                                                            <span class="badge bg-info">Đang xử lý</span>
                                                            break;
                                                        case "Shipping":
                                                            <span class="badge bg-primary">Đang giao</span>
                                                            break;
                                                        case "Delivered":
                                                            <span class="badge bg-success">Đã giao</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge bg-danger">Đã hủy</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary">@order.Status</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <a asp-action="Details" asp-route-id="@order.Id" 
                                                       class="btn btn-sm btn-outline-primary">
                                                        Chi tiết
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="History" asp-route-page="@(Model.CurrentPage - 1)">
                                            Trước
                                        </a>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="History" asp-route-page="@i">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="History" asp-route-page="@(Model.CurrentPage + 1)">
                                            Sau
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        }

    </div>
</section>
