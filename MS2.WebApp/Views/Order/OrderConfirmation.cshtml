@model MS2.Models.Entities.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<section class="py-5">
    <div class="container">
        
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm text-center">
                    <div class="card-body py-5">
                        
                        <!-- Success Icon -->
                        <div class="mb-4">
                            <svg class="text-success" width="80" height="80" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10s10-4.5 10-10S17.5 2 12 2m-2 15l-5-5l1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9Z"/>
                            </svg>
                        </div>

                        <!-- Success Message -->
                        <h2 class="text-success mb-3">Đặt hàng thành công!</h2>
                        <p class="lead mb-4">Cảm ơn bạn đã đặt hàng tại MiniMart</p>

                        <!-- Order Info -->
                        <div class="bg-light rounded p-4 mb-4">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <p class="text-muted mb-1">Mã đơn hàng</p>
                                    <h5 class="text-primary mb-0">#@Model.Id</h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-muted mb-1">Ngày đặt</p>
                                    <h5 class="mb-0">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-muted mb-1">Trạng thái</p>
                                    <h5 class="mb-0"><span class="badge bg-warning text-dark">Chờ xử lý</span></h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <p class="text-muted mb-1">Tổng tiền</p>
                                    <h5 class="text-primary mb-0">@Model.TotalAmount.ToString("N0") đ</h5>
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="alert alert-info mb-4">
                            <svg width="20" height="20" class="me-2" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M13 9h-2V7h2m0 10h-2v-6h2m-1-9A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2Z"/>
                            </svg>
                            Đơn hàng của bạn đang được xử lý. Chúng tôi sẽ liên hệ với bạn sớm nhất!
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                                <svg width="16" height="16" class="me-1" viewBox="0 0 24 24">
                                    <use xlink:href="#cart"></use>
                                </svg>
                                Xem chi tiết đơn hàng
                            </a>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                                <svg width="16" height="16" class="me-1" viewBox="0 0 24 24">
                                    <use xlink:href="#search"></use>
                                </svg>
                                Tiếp tục mua sắm
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
