@model MS2.Models.Entities.User
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<section class="py-5">
    <div class="container">
        
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-md-12">
                <h2 class="text-primary">Hồ sơ cá nhân</h2>
                <p class="text-muted">Quản lý thông tin tài khoản của bạn</p>
            </div>
        </div>

        <!-- Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <!-- User Info Card -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="row mb-4">
                            <div class="col-md-12 text-center">
                                <div class="mb-3">
                                    <svg class="text-primary" width="80" height="80">
                                        <use xlink:href="#user"></use>
                                    </svg>
                                </div>
                                <h4 class="mb-1">@Model.FullName</h4>
                                <p class="text-muted mb-0">@@@Model.Username</p>
                                <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-primary") mt-2">
                                    @Model.Role
                                </span>
                            </div>
                        </div>

                        <hr />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Tên đăng nhập</label>
                                <p class="mb-0 fw-semibold">@Model.Username</p>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted small">Email</label>
                                <p class="mb-0 fw-semibold">@Model.Email</p>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted small">Số điện thoại</label>
                                <p class="mb-0 fw-semibold">@(Model.Phone ?? "Chưa cập nhật")</p>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted small">Vai trò</label>
                                <p class="mb-0 fw-semibold">@Model.Role</p>
                            </div>

                            <div class="col-md-12">
                                <label class="text-muted small">Địa chỉ</label>
                                <p class="mb-0 fw-semibold">@(Model.Address ?? "Chưa cập nhật")</p>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted small">Ngày tạo tài khoản</label>
                                <p class="mb-0 fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy")</p>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted small">Trạng thái</label>
                                <p class="mb-0">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Bị khóa</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Thao tác</h5>
                        <div class="d-grid gap-2">
                            <a asp-action="EditProfile" class="btn btn-primary">
                                <svg width="16" height="16" class="me-2" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83l3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25Z"/>
                                </svg>
                                Chỉnh sửa hồ sơ
                            </a>
                            <a asp-action="ChangePassword" class="btn btn-outline-primary">
                                <svg width="16" height="16" class="me-2" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5l-9-4m0 6c1.4 0 2.8 1.1 2.8 2.5V11c.6 0 1.2.6 1.2 1.3v3.5c0 .6-.6 1.2-1.3 1.2H9.2c-.6 0-1.2-.6-1.2-1.3v-3.5c0-.6.6-1.2 1.2-1.2V9.5C9.2 8.1 10.6 7 12 7m0 1.2c-.8 0-1.5.5-1.5 1.3V11h3V9.5c0-.8-.7-1.3-1.5-1.3Z"/>
                                </svg>
                                Đổi mật khẩu
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Liên kết nhanh</h5>
                        <div class="d-grid gap-2">
                            <a asp-controller="Order" asp-action="History" class="btn btn-outline-secondary">
                                <svg width="16" height="16" class="me-2" viewBox="0 0 24 24">
                                    <use xlink:href="#cart"></use>
                                </svg>
                                Lịch sử đơn hàng
                            </a>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                                <svg width="16" height="16" class="me-2" viewBox="0 0 24 24">
                                    <use xlink:href="#search"></use>
                                </svg>
                                Xem sản phẩm
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
