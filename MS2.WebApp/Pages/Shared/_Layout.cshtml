<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMart Smart</title>
    <meta name="description" content="@(ViewData["Description"] ?? "MiniMart Smart – Siêu thị tiện lợi trực tuyến")" />

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@{
    var cartCountJson = Context.Session.GetString("Cart");
    var cartCount = 0;
    if (!string.IsNullOrEmpty(cartCountJson))
    {
        try
        {
            var cartItems = System.Text.Json.JsonSerializer.Deserialize<List<MS2.WebApp.Models.CartItemViewModel>>(cartCountJson);
            cartCount = cartItems?.Sum(x => x.Quantity) ?? 0;
        }
        catch { }
    }

    var isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
    var username = Context.Session.GetString("Username") ?? "";
    var fullName = Context.Session.GetString("FullName") ?? username;
    var role = Context.Session.GetString("Role") ?? "";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top ms2-navbar">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
            <div class="brand-icon">
                <i class="bi bi-cart-heart-fill"></i>
            </div>
            <span class="brand-text">MiniMart <span class="brand-accent">Smart</span></span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
            <!-- Search Bar (center) -->
            <div class="mx-auto search-wrapper d-none d-lg-block">
                <form asp-page="/Products/Index" method="get" class="d-flex position-relative">
                    <input class="form-control search-input" type="search" name="search"
                           placeholder="Tìm kiếm sản phẩm..." value="@Context.Request.Query["search"]" />
                    <button class="btn search-btn" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- Right Nav -->
            <ul class="navbar-nav ms-lg-3 align-items-lg-center gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Products/Index">
                        <i class="bi bi-grid me-1"></i>Sản phẩm
                    </a>
                </li>

                <!-- Cart -->
                <li class="nav-item">
                    <a class="nav-link position-relative" asp-page="/Cart/Index">
                        <i class="bi bi-cart3 fs-5"></i>
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge">@(cartCount > 99 ? "99+" : cartCount.ToString())</span>
                        }
                    </a>
                </li>

                <!-- User -->
                @if (isLoggedIn)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <div class="user-avatar">@(fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U")</div>
                            <span class="d-none d-xl-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 ms2-dropdown">
                            <li class="dropdown-header px-3 py-2">
                                <small class="text-muted">Đang đăng nhập</small>
                                <div class="fw-semibold">@fullName</div>
                                @if (!string.IsNullOrEmpty(role))
                                {
                                    <span class="badge ms2-role-badge mt-1">@role</span>
                                }
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item" asp-page="/Order/History"><i class="bi bi-clock-history me-2"></i>Lịch sử đơn hàng</a></li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <form asp-page="/Account/Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm px-3" asp-page="/Account/Register">Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Mobile Search Bar -->
<div class="d-lg-none mobile-search-bar bg-white border-bottom px-3 py-2">
    <form asp-page="/Products/Index" method="get" class="d-flex position-relative">
        <input class="form-control search-input-mobile" type="search" name="search"
               placeholder="Tìm kiếm..." value="@Context.Request.Query["search"]" />
        <button class="btn search-btn-mobile ms-2" type="submit">
            <i class="bi bi-search"></i>
        </button>
    </form>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="toastContainer">
    @if (TempData["Success"] != null)
    {
        <div class="toast ms2-toast ms2-toast-success show" id="toastSuccess" role="alert">
            <div class="toast-header border-0">
                <i class="bi bi-check-circle-fill me-2 text-success"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast ms2-toast ms2-toast-error show" id="toastError" role="alert">
            <div class="toast-header border-0">
                <i class="bi bi-exclamation-circle-fill me-2 text-danger"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["Error"]</div>
        </div>
    }
</div>

<!-- Main Content -->
<main class="flex-grow-1">
    @RenderBody()
</main>

<!-- Footer -->
<footer class="ms2-footer mt-5">
    <div class="container">
        <div class="row g-4 py-5">
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="brand-icon-sm"><i class="bi bi-cart-heart-fill"></i></div>
                    <span class="fw-bold fs-5 text-white">MiniMart Smart</span>
                </div>
                <p class="text-muted small">Hệ thống siêu thị thông minh – nhanh, tiện lợi và an toàn. Cam kết chất lượng sản phẩm và dịch vụ tốt nhất.</p>
            </div>
            <div class="col-sm-6 col-lg-2">
                <h6 class="text-white fw-semibold mb-3">Mua sắm</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a asp-page="/Products/Index" class="footer-link">Tất cả sản phẩm</a></li>
                    <li class="mb-2"><a asp-page="/Cart/Index" class="footer-link">Giỏ hàng</a></li>
                    @if (isLoggedIn)
                    {
                        <li class="mb-2"><a asp-page="/Order/History" class="footer-link">Đơn hàng của tôi</a></li>
                    }
                </ul>
            </div>
            <div class="col-sm-6 col-lg-3">
                <h6 class="text-white fw-semibold mb-3">Tài khoản</h6>
                <ul class="list-unstyled small">
                    @if (isLoggedIn)
                    {
                        <li class="mb-2"><a asp-page="/Account/Profile" class="footer-link">Hồ sơ cá nhân</a></li>
                        <li class="mb-2"><a asp-page="/Account/ChangePassword" class="footer-link">Đổi mật khẩu</a></li>
                    }
                    else
                    {
                        <li class="mb-2"><a asp-page="/Account/Login" class="footer-link">Đăng nhập</a></li>
                        <li class="mb-2"><a asp-page="/Account/Register" class="footer-link">Đăng ký</a></li>
                    }
                </ul>
            </div>
            <div class="col-lg-3">
                <h6 class="text-white fw-semibold mb-3">Liên hệ</h6>
                <ul class="list-unstyled small text-muted">
                    <li class="mb-2"><i class="bi bi-telephone me-2"></i>1800 1234</li>
                    <li class="mb-2"><i class="bi bi-envelope me-2"></i>support@minimart.vn</li>
                    <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>Hồ Chí Minh, Việt Nam</li>
                </ul>
            </div>
        </div>
        <div class="border-top border-secondary py-3 text-center">
            <small class="text-muted">&copy; 2026 MiniMart Smart System. Bảo lưu mọi quyền.</small>
        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Auto-dismiss toasts -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.toast.show').forEach(function (el) {
            var toast = new bootstrap.Toast(el, { delay: 4000 });
            toast.show();
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
