@page
@model MS2.WebApp.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <h4 class="section-title mb-0"><i class="bi bi-cart3 me-2" style="color:#6366f1"></i>Giỏ hàng của bạn</h4>
        @if (Model.CartItems.Any())
        {
            <span class="badge ms2-role-badge">@Model.CartItems.Sum(x => x.Quantity) sản phẩm</span>
        }
    </div>

    @if (Model.CartItems.Any())
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="ms2-card p-0 overflow-hidden">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Sản phẩm (@Model.CartItems.Count)</span>
                        <form asp-page-handler="Clear" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Xóa toàn bộ giỏ hàng?')">
                                <i class="bi bi-trash me-1"></i>Xóa tất cả
                            </button>
                        </form>
                    </div>
                    <div class="table-responsive">
                        <table class="table cart-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="product-img-wrap" style="width:52px;height:52px;border-radius:10px;flex-shrink:0">
                                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="product-img-placeholder" style="font-size:1.4rem"><i class="bi bi-box-seam"></i></div>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-600" style="font-size:0.9rem">@item.ProductName</div>
                                                    <small class="text-muted">Còn @item.Stock trong kho</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center" style="color:#6366f1;font-weight:600">@item.Price.ToString("N0")₫</td>
                                        <td class="text-center">
                                            <form asp-page-handler="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                                        class="btn btn-outline-secondary btn-sm px-2 py-1">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="cart-quantity-input">@item.Quantity</span>
                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                                        class="btn btn-outline-secondary btn-sm px-2 py-1"
                                                        @(item.Quantity >= item.Stock ? "disabled" : "")>
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end pe-4 fw-700" style="color:#0f172a">@item.Subtotal.ToString("N0")₫</td>
                                        <td>
                                            <form asp-page-handler="Remove" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm text-danger border-0 bg-transparent">
                                                    <i class="bi bi-x-circle fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-page="/Products/Index" class="text-muted text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="cart-summary-card">
                    <h6 class="fw-700 mb-4">Tóm tắt đơn hàng</h6>
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>Tạm tính (@Model.CartItems.Sum(x => x.Quantity) sản phẩm)</span>
                        <span>@Model.CartTotal.ToString("N0")₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>Phí vận chuyển</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-700 fs-6">Tổng cộng</span>
                        <span class="fw-700 fs-5" style="color:#6366f1">@Model.CartTotal.ToString("N0")₫</span>
                    </div>

                    @if (Model.IsLoggedIn)
                    {
                        <a asp-page="/Order/Checkout" class="btn btn-ms2 w-100 py-2 mb-2">
                            <i class="bi bi-credit-card me-2"></i>Tiến hành đặt hàng
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-ms2 w-100 py-2 mb-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập để đặt hàng
                        </a>
                    }
                    <small class="text-muted d-block text-center" style="font-size:0.78rem">
                        <i class="bi bi-shield-check me-1"></i>Thanh toán bảo mật & an toàn
                    </small>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state py-5">
            <div class="empty-state-icon"><i class="bi bi-cart-x"></i></div>
            <h5>Giỏ hàng của bạn đang trống</h5>
            <p>Hãy khám phá và thêm những sản phẩm bạn yêu thích!</p>
            <a asp-page="/Products/Index" class="btn btn-ms2 mt-2 px-4">
                <i class="bi bi-grid me-2"></i>Khám phá sản phẩm
            </a>
        </div>
    }
</div>
