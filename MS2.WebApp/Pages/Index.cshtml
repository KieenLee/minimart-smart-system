@page
@model MS2.WebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ – MiniMart Smart";
}

<!-- Hero Banner -->
<section class="hero-banner position-relative">
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-badge"><i class="bi bi-lightning-fill me-1"></i>Giao hàng nhanh toàn quốc</div>
                <h1 class="hero-title mb-3">
                    Mua sắm <span>thông minh</span><br />hơn mỗi ngày
                </h1>
                <p class="hero-desc mb-4">
                    Hàng nghìn sản phẩm chất lượng, giá cả hợp lý. Đặt hàng dễ dàng, giao tận nơi.
                </p>
                <div class="d-flex gap-3 flex-wrap mb-4">
                    <a asp-page="/Products/Index" class="btn btn-ms2 btn-lg px-4">
                        <i class="bi bi-grid me-2"></i>Mua sắm ngay
                    </a>
                    @if (!HttpContext.Session.GetInt32("UserId").HasValue)
                    {
                        <a asp-page="/Account/Register" class="btn btn-ms2-outline btn-lg px-4" style="color:#a78bfa;border-color:#a78bfa">
                            Đăng ký miễn phí
                        </a>
                    }
                </div>
                <div class="hero-stats">
                    <div>
                        <div class="hero-stat-num">@Model.ProductCount<span style="color:#a78bfa">+</span></div>
                        <div class="hero-stat-label">Sản phẩm</div>
                    </div>
                    <div>
                        <div class="hero-stat-num">@Model.CategoryCount<span style="color:#a78bfa">+</span></div>
                        <div class="hero-stat-label">Danh mục</div>
                    </div>
                    <div>
                        <div class="hero-stat-num">24/7</div>
                        <div class="hero-stat-label">Hỗ trợ</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div style="font-size:12rem;line-height:1;filter:drop-shadow(0 20px 40px rgba(99,102,241,0.4))">🛒</div>
            </div>
        </div>
    </div>
</section>

<!-- Category Pills -->
@if (Model.Categories.Any())
{
    <section class="py-4 bg-white border-bottom">
        <div class="container">
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <span class="text-muted small fw-semibold me-2">Danh mục:</span>
                <a asp-page="/Products/Index" class="category-pill @(string.IsNullOrEmpty(HttpContext.Request.Query["categoryId"]) ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i>Tất cả
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-page="/Products/Index" asp-route-categoryId="@cat.Id" class="category-pill">@cat.Name</a>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products -->
<section class="py-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="section-title mb-1">Sản phẩm nổi bật</h2>
                <p class="section-subtitle mb-0">Những sản phẩm được yêu thích nhất</p>
            </div>
            <a asp-page="/Products/Index" class="btn btn-ms2-outline">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (Model.FeaturedProducts.Any())
        {
            <div class="row g-3">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3 product-wrapper" data-product-id="@product.Id">
                        <div class="ms2-card product-card h-100 p-3">
                            <div class="position-relative mb-3">
                                <div class="product-img-wrap">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-img-placeholder"><i class="bi bi-box-seam"></i></div>
                                    }
                                </div>
                                <span class="product-badge badge status-badge-pending" data-stock-for="@product.Id" style="@(product.Stock > 10 ? "display:none;" : "")">
                                    Còn @product.Stock
                                </span>
                            </div>
                            <div class="mb-1">
                                <small class="text-muted" style="font-size:0.75rem">@(product.Category?.Name ?? "Chung")</small>
                            </div>
                            <h6 class="fw-600 mb-1" style="font-size:0.9rem;line-height:1.3">@product.Name</h6>
                            <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                                <span class="fw-700" style="color:#6366f1;font-size:1.05rem">
                                    @product.Price.ToString("N0")₫
                                </span>
                                @if (product.Stock > 0)
                                {
                                    <form asp-page="/Cart/Index" asp-page-handler="AddToCart" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-ms2 btn-sm px-3">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm px-3" disabled>Hết</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                <h5>Chưa có sản phẩm</h5>
                <p>Hãy quay lại sau nhé!</p>
            </div>
        }
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-sm-6 col-lg-3">
                <div class="p-4">
                    <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;background:linear-gradient(135deg,#dbeafe,#bfdbfe);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.6rem">🚚</div>
                    <h6 class="fw-700 mb-1">Giao hàng nhanh</h6>
                    <p class="text-muted small mb-0">Giao hàng trong ngày nội thành</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-4">
                    <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;background:linear-gradient(135deg,#dcfce7,#bbf7d0);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.6rem">✅</div>
                    <h6 class="fw-700 mb-1">Chất lượng đảm bảo</h6>
                    <p class="text-muted small mb-0">Sản phẩm được kiểm tra nghiêm ngặt</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-4">
                    <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;background:linear-gradient(135deg,#fef3c7,#fde68a);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.6rem">💳</div>
                    <h6 class="fw-700 mb-1">Thanh toán an toàn</h6>
                    <p class="text-muted small mb-0">Bảo mật thông tin người dùng</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-4">
                    <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;background:linear-gradient(135deg,#ede9fe,#ddd6fe);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.6rem">🎧</div>
                    <h6 class="fw-700 mb-1">Hỗ trợ 24/7</h6>
                    <p class="text-muted small mb-0">Luôn sẵn sàng giải đáp thắc mắc</p>
                </div>
            </div>
        </div>
    </div>
</section>
