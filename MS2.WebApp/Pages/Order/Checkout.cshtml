@page
@model MS2.WebApp.Pages.Order.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-4" style="max-width:1000px">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb ms2-breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Cart/Index" style="color:#6366f1">Giỏ hàng</a></li>
            <li class="breadcrumb-item active">Thanh toán</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Receiver Info Form -->
        <div class="col-lg-7">
            <div class="ms2-card p-4">
                <h5 class="fw-700 mb-4"><i class="bi bi-geo-alt me-2" style="color:#6366f1"></i>Thông tin giao hàng</h5>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger d-flex gap-2"><i class="bi bi-exclamation-circle-fill"></i>@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.ReceiverName" class="form-label"></label>
                            <input asp-for="Input.ReceiverName" class="form-control" placeholder="Họ và tên người nhận" />
                            <span asp-validation-for="Input.ReceiverName" class="text-danger text-validation"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.PhoneNumber" class="form-label"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="0901234567" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger text-validation"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.DeliveryAddress" class="form-label"></label>
                            <textarea asp-for="Input.DeliveryAddress" class="form-control" rows="2"
                                      placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                            <span asp-validation-for="Input.DeliveryAddress" class="text-danger text-validation"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Note" class="form-label">Ghi chú <span class="text-muted fw-normal">(tuỳ chọn)</span></label>
                            <input asp-for="Input.Note" class="form-control" placeholder="Giao giờ hành chính, để ở cổng..." />
                            <span asp-validation-for="Input.Note" class="text-danger text-validation"></span>
                        </div>
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-ms2 w-100 py-2">
                                <i class="bi bi-check-circle me-2"></i>Đặt hàng ngay
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-5">
            <div class="cart-summary-card">
                <h6 class="fw-700 mb-3">Đơn hàng (@Model.CartItems.Count sản phẩm)</h6>
                <div class="overflow-auto" style="max-height:280px">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between align-items-start mb-2 py-2 border-bottom">
                            <div class="flex-grow-1 me-3">
                                <div style="font-size:0.875rem;font-weight:600">@item.ProductName</div>
                                <small class="text-muted">x@(item.Quantity) × @item.Price.ToString("N0")₫</small>
                            </div>
                            <span class="fw-600 text-nowrap" style="color:#6366f1">@item.Subtotal.ToString("N0")₫</span>
                        </div>
                    }
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-1 text-muted small">
                    <span>Tạm tính</span><span>@Model.CartTotal.ToString("N0")₫</span>
                </div>
                <div class="d-flex justify-content-between mb-1 text-muted small">
                    <span>Phí giao hàng</span><span class="text-success fw-semibold">Miễn phí</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="fw-700">Tổng cộng</span>
                    <span class="fw-700 fs-5" style="color:#6366f1">@Model.CartTotal.ToString("N0")₫</span>
                </div>
                <div class="mt-3 p-3 rounded-3 d-flex align-items-start gap-2" style="background:#f0fdf4">
                    <i class="bi bi-shield-check text-success mt-1"></i>
                    <small class="text-muted">Đơn hàng được bảo vệ bởi chính sách mua hàng an toàn của MiniMart Smart.</small>
                </div>
                <div class="mt-2 p-3 rounded-3 d-flex align-items-start gap-2" style="background:#e0e7ff; color:#3730a3">
                    <i class="bi bi-clock-history mt-1"></i>
                    <small><b>Thời gian nhận hàng dự kiến:</b> 2 tiếng sau thời gian đặt.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
