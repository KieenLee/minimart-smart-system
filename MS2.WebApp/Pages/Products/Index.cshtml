@page
@model MS2.WebApp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="container py-4">
    <!-- Breadcrumb + Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="section-title mb-1">Tất cả sản phẩm</h4>
            <p class="text-muted mb-0 small">@Model.Products.Count sản phẩm</p>
        </div>
    </div>

    <!-- Filter Row -->
    <div class="ms2-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-5">
                <label class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tên sản phẩm, barcode..."
                           value="@Model.CurrentSearch" />
                </div>
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label small fw-semibold text-muted">Danh mục</label>
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CurrentCategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-ms2 px-4">Lọc</button>
                @if (!string.IsNullOrEmpty(Model.CurrentSearch) || Model.CurrentCategoryId.HasValue)
                {
                    <a asp-page="/Products/Index" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Product Grid -->
    @if (Model.Products.Any())
    {
        <div class="row g-3" id="productGrid">
            @foreach (var product in Model.PagedProducts)
            {
                <div class="col-6 col-md-4 col-lg-3 product-wrapper" data-product-id="@product.Id">
                    <div class="ms2-card product-card h-100 p-3">
                        <div class="position-relative mb-3">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder"><i class="bi bi-box-seam"></i></div>
                                }
                            </div>
                            <span class="product-badge badge status-badge-pending" data-stock-for="@product.Id" style="@(product.Stock > 10 ? "display:none;" : "")">
                                Còn @product.Stock
                            </span>
                        </div>
                        <div class="mb-1">
                            <small class="text-muted" style="font-size:0.75rem">@(product.Category?.Name ?? "Chung")</small>
                        </div>
                        <h6 class="mb-2" style="font-size:0.88rem;line-height:1.3;font-weight:600">@product.Name</h6>
                        <div class="d-flex align-items-center justify-content-between mt-auto">
                            <span class="fw-700" style="color:#6366f1;font-size:1.05rem">
                                @product.Price.ToString("N0")₫
                            </span>
                            @if (product.Stock > 0)
                            {
                                <form asp-page="/Cart/Index" asp-page-handler="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="/Products/Index?search=@Model.CurrentSearch&categoryId=@Model.CurrentCategoryId&p=@Model.CurrentPage" />
                                    <button type="submit" class="btn btn-ms2 btn-sm px-3" title="Thêm vào giỏ hàng">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm px-3" disabled>Hết</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="/Products/Index"
                               asp-route-search="@Model.CurrentSearch"
                               asp-route-categoryId="@Model.CurrentCategoryId"
                               asp-route-p="@(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/Products/Index"
                               asp-route-search="@Model.CurrentSearch"
                               asp-route-categoryId="@Model.CurrentCategoryId"
                               asp-route-p="@i">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="/Products/Index"
                               asp-route-search="@Model.CurrentSearch"
                               asp-route-categoryId="@Model.CurrentCategoryId"
                               asp-route-p="@(Model.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-search"></i></div>
            <h5>Không tìm thấy sản phẩm</h5>
            <p>Hãy thử tìm kiếm với từ khoá khác hoặc xoá bộ lọc.</p>
            <a asp-page="/Products/Index" class="btn btn-ms2 mt-2">Xem tất cả sản phẩm</a>
        </div>
    }
</div>
